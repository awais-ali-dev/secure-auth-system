# --- Server ---
PORT=3000
SESSION_SECRET=replace_with_a_long_random_string

# --- Google OAuth 2.0 ---
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=replace_with_your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_with_your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# --- AES-256 Encryption ---
# Must be exactly 32 bytes. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AES_ENCRYPTION_KEY=replace_with_64_hex_characters_32_bytes
